%------------------------------
\section{Introduction}
%------------------------------

\begin{frame}{Project Goal}
    \begin{itemize}
        \item Enhance Human-Benchmark web app with real-time chat capabilities
        \item Two chat scopes:
        \begin{itemize}
            \item \textbf{Global}: All logged-in users
            \item \textbf{Room}: Participants in active game rooms
        \end{itemize}
        \item Implemented using ICONIX process
    \end{itemize}
\end{frame}

%------------------------------
\section{Implementation Options}
%------------------------------

\begin{frame}{Implementation Strategies}
    \begin{columns}
        \column{0.5\textwidth}
        \textbf{From Scratch}
        \begin{itemize}
            \item[+] Full control
            \item[+] No 3rd-party costs
            \item[-] High development effort
        \end{itemize}
        
        \column{0.5\textwidth}
        \textbf{Third-Party (Stream)}
        \begin{itemize}
            \item[+] Faster deployment
            \item[+] Managed infrastructure
            \item[-] Recurring costs
        \end{itemize}
    \end{columns}
    
    \vspace{5mm}
    \centering
    \textbf{Selected: Custom implementation} for flexibility
\end{frame}

