@startuml
actor User
participant "Browser WS Client" as WSC
participant "NotificationGateway" as NG
participant "NotificationService" as NS

note over WSC, NG
  WebSocket connection established
end note

NS -> NG: publish(event)
NG --> WSC: push(event) ##async###
WSC -> Browser: playSound()
WSC -> Browser: showToast(event)
@enduml
