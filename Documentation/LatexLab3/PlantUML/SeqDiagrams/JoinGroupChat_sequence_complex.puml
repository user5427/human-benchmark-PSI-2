@startuml
actor User
participant "CreateChatSection" as UI
participant "ChatController" as CC
participant "GroupChatService" as GCS
participant "OwnerClient" as Owner
participant "NotificationService" as NS
participant "Database" as DB

User -> UI: openJoinGroup()
User -> UI: enterGroupName(name)
UI -> CC: requestJoin(name, userId)

activate CC
CC -> GCS: resolveChatIdByName(name)
GCS -> DB: SELECT chatId, ownerId FROM GroupChat WHERE name = ?
DB -> GCS: chatId, ownerId or null

alt Chat Not Found
    GCS -> CC: error(chatNotFound)
    CC -> UI: showError("Chat not found")
else Chat Found
    GCS -> CC: chatId, ownerId
    CC --> NS: requestApproval(ownerId, chatId, userId)
    NS --> Owner: push "join-request"

    Owner -> CC: approveJoin(chatId, userId)
    CC -> GCS: addMember(chatId, userId)
    GCS -> DB: INSERT INTO GroupMember
    DB -> GCS: ok
    GCS -> CC: memberAdded
    CC --> NS: notifyAdded(userId, chatId)
    CC -> UI: showPending("Waiting for owner")
end alt

deactivate CC
@enduml
